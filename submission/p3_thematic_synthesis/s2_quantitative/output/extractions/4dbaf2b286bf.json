  },
  "has_quantitative_results": true,
  "summary": "The paper proposes a noise‑optimization mechanism (NO‑VQC) that perturbs training data during optimization to escape barren plateaus in variational quantum classifiers. In simulations with 3–9 qubits and 1–5 circuit layers on financial index prediction tasks, NO‑VQC statistically improves over a baseline VQC (Wilcoxon p-values often <0.05) and achieves test accuracies around 0.50–0.59 depending on configuration, occasionally matching classical models such as logistic regression and SVM (~0.71 median accuracy).",
  "experiments": [
    {
      "experiment_id": "exp_1",
      "description": "Variational quantum classifier (VQC) for predicting BET index direction versus multiple international stock-index feature sets, with a proposed noise-optimization mechanism (NO-VQC) that perturbs training data during stagnation to help escape barren plateaus; compared against the baseline VQC on the same train/test splits and initial parameters.",
      "algorithm": {
        "family": "other-gate-based",
        "variant": "Noise-Optimization Variational Quantum Classifier (NO-VQC) / baseline VQC",
        "ansatz": "AngleEmbedding followed by layers of Rx, Ry, Rz on each qubit and linear CNOT entanglement",
        "optimizer": "GradientDescentOptimizer",
        "num_layers": 1,
        "convergence_criteria": "max 100 optimization epochs; optimization on shifted data for nnoise=2 iterations after stagnation/noise trigger",
        "hyperparameters": {
          "noise_magnitude": "0.1",
          "nepochs": 100,
          "nstagnation": 5,
          "enoise": 0.1,
          "nnoise": 2,
          "optimizer_step_size": 0.1,
          "num_independent_runs": 10,
          "test_intervals": 20,
          "interval_size_days": 20,
          "seed": 42
        },
        "parameter_initialization": "random initialization of variational parameters using the same random seed for VQC and NO-VQC",
        "optimizer_settings": {
          "max_iterations": 100,
          "step_size": 0.1,
          "learning_rate_schedule": null,
          "parameter_bounds": null
        }
      },
      "problem_formulation": {
        "encoding_method": "angle_encoding",
        "encoding_details": "Each feature is encoded into a qubit using AngleEmbedding with Ry rotations; number of qubits equals number of features used in the circuit. The paper notes that only the first two features were used in some illustrative loss-landscape plots.",
        "objective_function": "Minimize mean-squared error loss L(θ|X,Y) = (1/N) Σ_v (f_θ(x_v) - y_v)^2 for binary classification of BET up/down movement",
        "constraints_handling": null,
        "num_binary_variables": null,
        "problem_hamiltonian": null,
        "num_ancilla_qubits": null
      },
      "problem_instance": {
        "description": "Binary classification of short-term BET index movement using other market indices as features",
        "num_assets": 10,
        "time_steps": 2012,
        "num_features": 3,
        "dataset_size": 20,
        "data_type": "real_market",
        "dataset_name": "BET vs. USA / WE / CEE / ALL",
        "dataset_specification": {
          "ticker_symbols": [
            "BET",
            "NASDAQ",
            "S&P500",
            "DJIA",
            "FTSE100",
            "CAC40",
            "DAX",
            "ATX",
            "BUX",
            "WIG20"
          ],
          "date_range": "2012-01-04 to 2022-12-22",
          "benchmark_name": "Bucharest Exchange Trading (BET) index",
          "preprocessing": "standardization; bounded uniform noise added to training data during stagnation; same train-test splits and same initial parameters used for VQC and NO-VQC",
          "train_test_split": "random split within each 20-day interval; seed 42"
        },
        "data_preprocessing_details": "Training data standardized; for NO-VQC, a bounded uniform random shift U(-0.1,0.1) is added to the standardized training data when stagnation is detected or with probability 0.1, then the shifted data are standardized again",
        "evaluation_methodology": "10 independent runs per setting; accuracies recorded over epochs; Wilcoxon signed-rank test for paired comparison of VQC vs NO-VQC; Friedman and Nemenyi tests for comparison with classical baselines"
      },
      "quantum_resources": {
        "num_qubits": 10,
