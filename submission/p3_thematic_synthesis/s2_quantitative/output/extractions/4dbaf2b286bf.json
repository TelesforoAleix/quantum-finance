  "paper_metadata": {
    "title": "A Noisy Optimization mechanism for variational quantum classifiers",
    "authors": [
      "Rodica Ioana Lung",
      "Florin Sebastian Duma"
    ],
    "year": 2026,
    "doi": "10.1016/j.knosys.2026.115659",
