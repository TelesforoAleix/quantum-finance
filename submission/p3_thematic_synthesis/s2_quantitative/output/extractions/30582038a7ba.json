  "has_quantitative_results": true,
  "summary": "The paper proposes a periodic-unitary quantum kernel for time-series anomaly detection and evaluates it using 2‑qubit noiseless Qiskit simulations on the NYC Taxi dataset. The best quantum model (7‑period Hamiltonian) achieves balanced accuracy 0.816 ± 0.148 and F1-score 0.733 ± 0.263, but classical baselines outperform it, with an RBF kernel reaching balanced accuracy 0.869 ± 0.153 and F1-score 0.814 ± 0.222.",
  "experiments": [
    {
      "experiment_id": "exp_1",
      "description": "Quantum kernel-based one-class SVM for anomaly detection on the NYC taxi request time series, comparing a random Hamiltonian temporal kernel, a 1-period Hamiltonian kernel, and a 7-period Hamiltonian kernel (the proposed periodic unitary encoding).",
      "algorithm": {
        "family": "other-gate-based",
