      "problem_formulation": {
        "encoding_method": "hamiltonian-simulation-based-linear-system",
        "encoding_details": "Black's model is converted to a linear system via Lagrange multipliers; the HHL circuit solves the resulting matrix equation. The paper uses a 3-register HHL layout: Qv, QQPE, and Qa.",
        "objective_function": "min_w w^T Sigma w subject to w^T R = E and w^T 1 = 1; after scaling: min_w w^T Sigma w s.t. s1 w^T R = s1 E and s2 w^T 1 = s2",
        "constraints_handling": "Equivalent constraint scaling with two scaling factors s1 and s2; no penalty formulation. The auxiliary qubit uses Const = |lambda|min.",
        "num_binary_variables": null,
        "problem_hamiltonian": "Lagrange matrix ML from Black's model; standardized matrix M_L^std = (l/|lambda|max) ML with l=0.5.",
        "num_ancilla_qubits": 1
      },
      "problem_instance": {
        "description": "Portfolio optimization on market data using randomly selected stocks from Nasdaq, NYSE, and AMEX; problems range from 2 to 6 assets.",
        "num_assets": 2,
        "time_steps": 251,
        "num_features": null,
        "dataset_size": 3100,
        "data_type": "real_market",
        "dataset_name": "Nasdaq, NYSE, AMEX",
        "dataset_specification": {
          "description": "Stock price tables from the three exchanges; 3100 Nasdaq stocks over 251 days used for predictor training; 400 NYSE stocks and 40 AMEX stocks also used. Randomly select 3 stocks to construct training instances for the eigenvalue predictor."
        },
        "data_preprocessing_details": "Compute daily increments/returns from adjacent days; estimate expected returns and covariance matrix using Eq. (2); construct Lagrange matrix; pad matrix to power-of-two size with zeros and a scaled identity matrix; standardize by |lambda|max; use historical financial data for SVR training.",
        "evaluation_methodology": "Compare SAPO against basic HHL, Qiskit HHL, and hybrid HHL. Complexity evaluated for 2-6 assets and epsilon in {1/16,1/8,1/4}. Accuracy evaluated under fixed QPE qubit counts and fixed asset counts; results reported as averages and improvement ratios."
      },
