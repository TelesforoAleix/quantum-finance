  "has_quantitative_results": true,
  "summary": "The paper proposes SAPO, a modified HHL-based quantum portfolio optimization method that scales Black’s model constraints and predicts min/max eigenvalues using SVR. In simulation on 2–6 asset problems using Nasdaq/NYSE/AMEX data, SAPO reduces compiled circuit complexity by about 34.64–36.94% and improves allocation accuracy by up to 1.52× versus Qiskit HHL and 1.46× versus hybrid HHL.",
  "experiments": [
    {
      "experiment_id": "exp_1",
      "description": "SAPO: HHL-based quantum portfolio optimization with constraint scaling and min-max eigenvalue prediction, evaluated on real market datasets for 2- to 6-asset problems.",
      "algorithm": {
        "family": "other-gate-based",
        "variant": "SAPO (scaled HHL for Black's model with min-max eigenvalue predictor)",
