        "convergence_criteria": null,
        "hyperparameters": {
          "Hamiltonian_simulation_time_Ht": "pi",
          "normalization_constant": "|lambda|min",
          "QPE_qubits": "n_QPE >= 2 + ceil(log2(|lambda|max / (|lambda|min * epsilon)))",
          "absolute_error_epsilon": [
            "1/16",
            "1/8",
            "1/4"
          ],
