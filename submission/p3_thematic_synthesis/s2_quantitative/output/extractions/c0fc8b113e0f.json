      "problem_formulation": {
        "encoding_method": "hamiltonian_coefficient_encoding",
        "encoding_details": "Time-series log returns are encoded into Hamiltonian coefficients xi over windows of size 9; the quantum reservoir maps each window to a higher-dimensional embedding via unitary time evolution and measurement.",
        "objective_function": "Binary classification of volatility regime changes: ct = 1 if normalized rolling volatility \\u03c3~t exceeds threshold \\u03c4 = \\u03bc_\\u03c3~ + \\u03bb\\u03c3_\\u03c3~, else 0.",
        "constraints_handling": null,
        "num_binary_variables": null,
        "problem_hamiltonian": "H = HX + HZ + HZZ, with HX = AX \\u2211 Xi, HZ = AZ \\u2211 xi Zi, HZZ = AZZ \\u2211 (xi + xi+1) ZiZi+1",
        "num_ancilla_qubits": null
      },
