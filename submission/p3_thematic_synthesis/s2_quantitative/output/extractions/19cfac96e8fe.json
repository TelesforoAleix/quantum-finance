      "experiment_id": "exp_1",
      "description": "Hybrid quantum-classical A3C trading agent for weekly S&P 500 trading, comparing classical A3C vs quantum A3C, each with and without LSTM-based one-week-ahead macroeconomic/price forecasts; random policy used as a baseline.",
      "algorithm": {
        "family": "other-gate-based",
        "variant": "Quantum A3C / Fintech Quantum A3C with variational quantum circuit encoder",
        "ansatz": "8-qubit, depth-2 variational quantum circuit with angle encoding, trainable Ry and Rz rotations, and CNOT entanglers",
