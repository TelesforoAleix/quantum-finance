        "dataset_name": "JPX Tokyo Stock Exchange Prediction (Kaggle)",
        "dataset_specification": {
          "description": "Universe0 stocks from JPX stock list; daily open/high/low/close/volume/adjustment factor; target is two-day forward return with one-day execution delay"
        },
        "data_preprocessing_details": "Adjusted close computed using cumulative adjustment factors; returns, momentum, volatility, dollar volume, rolling means, and log-transformed features engineered; winsorization at 1st/99th percentiles; daily cross-sectional z-score standardization; chronological 80/20 split; stride sampling k=11; weakly supervised labels from top/bottom p stocks per day (p typically 200 or 300)",
        "evaluation_methodology": "Out-of-sample Sharpe ratio on long-short portfolios over 22 OOS days; 5 independent runs; paired bootstrap test with 10,000 resamples; Ledoit-Wolf robust Sharpe test; qubit scalability study over nq in {4,6,8,10,12}; noise-resilience study over multiple error rates"
