  "has_quantitative_results": true,
  "summary": "The paper proposes a hybrid Quantum Temporal Convolutional Neural Network (QTCNN) for stock return prediction and reports an out‑of‑sample Sharpe ratio of 0.538±0.042 on a JPX dataset, outperforming the best classical baseline (Transformer: 0.313±0.036) and other quantum models such as QNN (0.467±0.038). All experiments use simulated quantum circuits with 4–12 qubits (8 default) and shallow variational circuits implemented in PennyLane.",
  "experiments": [
    {
      "experiment_id": "exp_1",
      "description": "Hybrid quantum-classical temporal convolutional neural network (QTCNN) for cross-sectional equity return prediction on JPX Tokyo Stock Exchange data, benchmarked against quantum and classical baselines; includes scalability, ablation, and noise-resilience studies for the same model family.",
      "algorithm": {
        "family": "other-gate-based",
        "variant": "Quantum Temporal Convolutional Neural Network (QTCNN) with classical temporal CNN encoder + parameter-shared quantum convolutional layers",
