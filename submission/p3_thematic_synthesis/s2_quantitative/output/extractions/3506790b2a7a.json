  "has_quantitative_results": true,
  "summary": "The paper proposes a hybrid quantum–classical fraud detection model (HQRNN-FD) combining a variational quantum circuit with an RNN and attention mechanism. On a 1,754,155‑transaction fraud dataset, the model achieves accuracy 0.9715 and fraud-class F1-score 0.9009, outperforming classical CNN (accuracy 0.9373, F1 0.8037) and RNN (accuracy 0.9563, F1 0.8563) baselines in simulation using up to 6 qubits.",
  "experiments": [
    {
      "experiment_id": "exp_1",
      "description": "Hybrid quantum recurrent neural network for fraud detection using variational quantum circuits with angle encoding, data reuploading, hierarchical entanglement, RNN, and self-attention; evaluated on a public credit card fraud dataset with qubit-scaling and noise-robustness tests.",
      "algorithm": {
        "family": "other-gate-based",
        "variant": "HQRNN-FD (hybrid quantum recurrent neural network with self-attention)",
        "ansatz": "layered VQC with Hadamard initialization, dual-angle encoding (Ry/Rz), data reuploading, local and global CNOT entanglement, and U3 rotations",
        "optimizer": "Adam",
        "num_layers": 2,
        "convergence_criteria": "early stopping based on validation performance; max epochs 100",
        "hyperparameters": {
