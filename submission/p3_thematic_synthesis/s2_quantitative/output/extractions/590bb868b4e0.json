  "has_quantitative_results": true,
  "summary": "The paper proposes a hybrid frequency‑domain enhanced bi‑directional recurrent quantum network (FDBRQ) using 6‑qubit variational circuits (Ansatz depth 3) for stock prediction on four CSI‑300 stocks. On the 1‑step task for ticker 000651.XSHE it reports RMSE 0.2174, MAE 0.1448, and MAPE 0.3941, outperforming classical baselines such as DBLSTM (RMSE 0.3035). Experiments use historical data from 2018–2023 and appear to run entirely on classical simulation rather than quantum hardware.",
  "experiments": [
    {
      "experiment_id": "exp_1",
      "description": "Frequency-domain enhanced bi-directional recurrent quantum network (FDBRQ) for stock closing-price trend prediction on four Chinese CSI 300 constituent stocks, evaluated for 1-step, 5-step, and 20-step forecasting.",
      "algorithm": {
        "family": "other-gate-based",
        "variant": "frequency-domain enhanced bi-directional recurrent quantum network (FDBRQ) with forward and backward quantum circuit units",
        "ansatz": "quantum circuit unit (QCU) with Quantum Encoder + Quantum Ansatz; gate set includes H, Rz, Rx, Ry",
        "optimizer": "Adam",
        "num_layers": 3,
        "convergence_criteria": "100 training epochs; 20 independent experiments per neural-network method and average results reported",
