        "encoding_method": "basis_encoding",
        "encoding_details": "Density matrix represented in the computational basis and vectorized into a D^2-dimensional superket; for |+>^n the basis is rotated to Pauli-X basis to obtain a sparse initial state",
        "objective_function": "Simulate open-system master-equation dynamics dρ/dt = -i[H(t),ρ] + 1/2 Σ_k γ_k(t) D[L_k]ρ and estimate circuit fidelity / density-matrix elements",
        "constraints_handling": "Trace preservation via diagonal-walker normalization; sign-problem suppression via walker annihilation; optional initiator-style truncation of low-population states",
        "num_binary_variables": null,
        "problem_hamiltonian": "H_S = -ω_q Σ_i σ_z^i + J Σ_<i,j> σ_z^i σ_z^j (crosstalk model); gate Hamiltonians implemented as square pulses; GHZ uses CNOT decomposed into Rz, Rx, and Rzx pulses",
        "num_ancilla_qubits": null
      },
      "problem_instance": {
        "description": "Noisy simulation of gate-based quantum circuits: 10-qubit and larger crosstalk-suppression Ramsey-like experiments with dynamical decoupling, and GHZ-state preparation up to 30 qubits; supplemental 16-qubit benchmarks and 2-qubit non-Markovian open-system example",
