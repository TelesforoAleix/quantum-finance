      "experiment_id": "exp_1",
      "description": "Classical real-time quantum Monte Carlo simulation of noisy gate-based quantum circuits, benchmarked on crosstalk-suppressed free evolution and GHZ-state preparation circuits under Markovian noise.",
      "algorithm": {
        "family": "classical-simulation",
        "variant": "real-time sign-problem-suppressed quantum Monte Carlo (population-dynamics density-matrix simulation)",
