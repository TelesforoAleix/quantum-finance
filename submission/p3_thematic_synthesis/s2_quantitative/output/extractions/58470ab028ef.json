        "data_type": "public_benchmark",
        "dataset_name": "Credit Card Fraud Detection (ULB/Kaggle)",
        "dataset_specification": {
          "description": "30 features including Time, Amount, and PCA-derived V1-V28; labels are genuine (0) and fraudulent (1); random under-sampling used to balance classes for training"
        },
        "data_preprocessing_details": "Null handling, standardization, duplicate removal, PCA-based feature handling, random under-sampling of genuine transactions, normalization before angle encoding",
        "evaluation_methodology": "Performance reported for thresholds T=0.5, 0.6, 0.7 in noise-free simulation; noisy evaluation at T=0.7 on FakeCairo; ablation over circuit layers L=1 to 6"
