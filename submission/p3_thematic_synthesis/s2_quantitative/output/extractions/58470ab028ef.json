  "finance_domain": {
    "primary_silo": "fraud-detection",
    "secondary_silos": []
  },
  "has_quantitative_results": true,
  "summary": "The paper proposes a 4‑qubit variational quantum autoencoder (QAE‑FD) for credit‑card fraud detection using the ULB dataset. In simulation it achieves G‑mean ≈0.946 and AUC up to 0.974 at threshold 0.7, and under simulated IBM FakeCairo noise it reports precision 0.480, recall 0.765, and AUC 0.881. Experiments are limited to simulator studies with small circuits and do not demonstrate computational quantum advantage.",
  "experiments": [
    {
      "experiment_id": "exp_1",
      "description": "Quantum autoencoder-based fraud detection (QAE-FD) on a highly imbalanced credit card fraud dataset, evaluated in noise-free simulation and on a noisy IBM fake backend, with threshold sensitivity analysis and circuit-layer ablation.",
      "algorithm": {
        "family": "other-gate-based",
        "variant": "Quantum AutoEncoder-based Fraud Detection (QAE-FD) using only the encoder part of a QAE",
        "ansatz": "Variational quantum circuit with angle encoding followed by layers of Rx, Ry, Rz and CNOT gates",
        "optimizer": "Adam",
        "num_layers": 4,
        "convergence_criteria": "trained for 50 epochs",
        "hyperparameters": {
          "epochs": 50,
          "batch_size": 16,
          "learning_rate": 0.001,
          "optimizer": "Adam",
          "ansatz_layers": 4,
          "qubits": 4,
          "thresholds": [
            0.5,
            0.6,
            0.7
          ],
          "framework": "PennyLane"
        },
        "parameter_initialization": null,
        "optimizer_settings": {
          "max_iterations": 50,
          "learning_rate": 0.001,
          "parameter_bounds": null,
          "step_size": null,
          "tolerance": null,
          "learning_rate_schedule": null
        }
      },
      "problem_formulation": {
        "encoding_method": "angle_encoding",
        "encoding_details": "Classical transaction features are normalized and encoded into qubit rotation angles via Rx on each qubit; the model uses 4 qubits and compresses the input from 4 to 3 qubits with one trash qubit measured for loss.",
        "objective_function": "Minimize C(θ) = (1/K) Σ_i |1 - <Z_i>| on the trash qubit(s), and classify transactions by thresholding the probability of measuring |0>",
        "constraints_handling": "Threshold assessment on measurement probability; no explicit penalty formulation reported",
        "num_binary_variables": null,
        "problem_hamiltonian": null,
        "num_ancilla_qubits": null
      },
      "problem_instance": {
        "description": "Credit card fraud detection on a real-world imbalanced transaction dataset from European cardholders",
