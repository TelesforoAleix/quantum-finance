          "parameter_bounds": null
        }
      },
      "problem_formulation": {
        "encoding_method": "unary_encoding",
        "encoding_details": "Unary encoding for each stock position with D=2 legs; binary variables x_{l,d} mapped to fermionic occupation numbers n_{l,d}. For short positions, w_l = I/2 - sum_d f_d x_{l,d} with f_d=1 and I=D.",
        "objective_function": "E(w) = (lambda/M^2) sum_{l,l'} sigma_{l,l'} w_l w_{l'} - ((1-lambda)/M) sum_l mu_l w_l, subject to sum_l w_l = M",
        "constraints_handling": "Hard constraint enforced by fixed particle number C = sum_{l,d} n_{l,d}; no penalty term in FQAOA",
        "num_binary_variables": 16,
        "problem_hamiltonian": "Hp = (lambda/M^2) sum_{l,l'} sigma_{l,l'} sum_{d,d'} (n_{l,d}-1/2)(n_{l',d'}-1/2) + ((1-lambda)/M) sum_l mu_l sum_d (n_{l,d}-1/2)",
