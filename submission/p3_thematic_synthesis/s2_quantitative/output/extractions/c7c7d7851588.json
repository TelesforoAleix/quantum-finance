  "has_quantitative_results": true,
  "summary": "The paper proposes Fermionic QAOA (FQAOA) that enforces equality constraints through fermionic particle‑number conservation and evaluates it on a portfolio optimization problem with N=8 assets (16 qubits). In noiseless simulation up to depth p=10, optimized FQAOA achieves residual energy ΔE/W = 0.017 and low‑energy probability F(W/100) = 0.521, outperforming XY‑QAOA baselines and improving the probability of low‑energy states by about 40× at p=4.",
  "experiments": [
    {
      "experiment_id": "exp_1",
      "description": "Fermionic QAOA (FQAOA) applied to a portfolio optimization problem with short positions allowed, evaluated via numerical simulation and compared against X-QAOA and XY-QAOA baselines.",
      "algorithm": {
        "family": "qaoa",
        "variant": "fermionic QAOA (FQAOA) with hard constraints via particle-number conservation",
        "ansatz": "Π_j Um(β_j) Up(γ_j) with fermionic driver Hamiltonian and Slater-determinant initial state",
        "optimizer": "BFGS; conjugate gradient (CG)",
        "num_layers": 0,
        "convergence_criteria": null,
        "hyperparameters": {
          "lambda": 0.9,
          "A": 0.003,
          "D": 2,
          "N": 8,
          "M": 4,
          "t_parallel": "W/Wt",
          "t_perp": "W/Wt",
          "W": "energy range of Hp under constraints",
          "Wt": "energy range of Ht at t_parallel=t_perp=1",
          "W_delta_t": 10
        },
        "parameter_initialization": "Fixed-angle parameters from time-discretized QAA, (gamma_j^(0), beta_j^(0)) = ((2j-1)/(2p) * Delta t, (1 - (2j-1)/(2p)) * Delta t), then used as initial values for local optimization",
        "optimizer_settings": {
          "max_iterations": null,
