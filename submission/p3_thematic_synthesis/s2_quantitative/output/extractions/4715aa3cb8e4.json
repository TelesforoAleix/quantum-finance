        "dataset_name": "Kaggle Credit Card Fraud Detection",
        "dataset_specification": {
          "description": "284,807 original transactions; 492 frauds retained; majority class downsampled to 10,000 legitimate transactions; 30 PCA-like features plus derived hour-of-day feature from Time, then Time dropped; stratified 50/25/25 train/validation/test split; random_state=42"
        },
        "data_preprocessing_details": "PCA-like features already present; add hour-of-day feature from (Time/3600) mod 24; drop Time; downsample majority class to 10,000; keep all 492 frauds; fit StandardScaler on training set only; compute Pearson correlations on training set only; reorder features to place high-correlation pairs in same chunk",
        "evaluation_methodology": "100 randomized runs for 10-qubit settings and 20 randomized runs for 15-qubit settings; report precision, recall, PR-AUC, and CPU time on held-out test set"
