      "problem_formulation": {
        "encoding_method": "angle_encoding",
        "encoding_details": "30 PCA-like features are re-uploaded through Q qubits in C=ceil(30/Q) chunks; features are mapped to qubits after correlation-based reordering; RY rotations used for encoding",
        "objective_function": "Binary cross-entropy with logits, weighted by class imbalance: L = -w+ y log σ(h) - (1-y) log(1-σ(h)), with w+ = N0/N1",
        "constraints_handling": "Class weighting in loss; priority entanglement pairs restricted to features in the same re-uploading chunk; no QUBO/Ising formulation",
        "num_binary_variables": null,
        "problem_hamiltonian": null,
        "num_ancilla_qubits": null
      },
