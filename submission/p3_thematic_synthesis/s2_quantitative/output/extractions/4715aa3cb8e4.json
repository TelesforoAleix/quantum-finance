  "has_quantitative_results": true,
  "summary": "The paper evaluates a hybrid variational quantum neural network for fraud detection on the Kaggle credit-card dataset (10,000 legitimate + 492 fraud samples). A 15‑qubit, 1‑layer circuit with correlation-guided entanglement achieves PR‑AUC 0.9229±0.006 and recall ≈0.93, slightly outperforming the best classical baseline (logistic regression PR‑AUC 0.9150±0.014) under matched parameter budgets.",
  "experiments": [
    {
      "experiment_id": "exp_1",
      "description": "Hybrid quantum-classical fraud detection classifier using a variational quantum circuit with data re-uploading and priority entanglement, evaluated on the Kaggle credit card fraud dataset against a matched classical neural-network baseline.",
      "algorithm": {
        "family": "other-gate-based",
        "variant": "Hybrid QNN / variational quantum circuit classifier with data re-uploading and data-driven priority entanglement",
        "ansatz": "Angle embedding + CNOT priority entanglers + strongly entangling layer (SEL)",
        "optimizer": "Adam",
